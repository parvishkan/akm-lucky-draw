rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Prize images path: prizes/{prizeId}/{fileName}
    match /prizes/{prizeId}/{fileName} {
      // Public read access for customer prize reveal and admin preview
      allow read: if true;

      // Write access strictly requires authenticated user, max 5MB, valid image MIME type
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');

      // Deletion strictly requires authenticated user
      allow delete: if request.auth != null;
    }
  }
}
