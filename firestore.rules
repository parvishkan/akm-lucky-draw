rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Tokens: Anyone can read/verify, authenticated staff can create or block
    match /tokens/{tokenId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Prizes: Public can read active prizes, only authenticated staff can modify
    match /prizes/{prizeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Winners & Claims: Public read/create on win, authenticated staff update on claim
    match /winners/{winnerId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    match /claims/{claimId} {
      allow read, create: if true;
      allow update: if request.auth != null;
    }

    // Campaigns & Access Control: Public read, admin write
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admins & Security Audit Logs: Admin protected
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /activityLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
