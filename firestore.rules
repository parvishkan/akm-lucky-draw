rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Security Helper Function: Checks if request is from an authenticated AND active authorized admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    // Role Helper: Checks if admin has OWNER or SUPER_ADMIN role
    function isOwner() {
      return isAdmin() &&
        (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['OWNER', 'SUPER_ADMIN']);
    }

    // Role Helper: Checks if admin has session management authority (OWNER, SUPER_ADMIN, or ADMIN)
    function isSessionManager() {
      return isAdmin() &&
        (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['OWNER', 'SUPER_ADMIN', 'ADMIN']);
    }

    // Master Owner Check: Checks if request is from the immutable Master Owner account
    function isMasterOwner() {
      return request.auth != null && request.auth.uid == 'PXvOs3LHpoaowbgmfqrg2BT15uA2';
    }

    // 1. Admin Registry: Active admins can read registry; ONLY OWNERs can write (create/update/delete admins).
    // Customers CANNOT create /admins/{customerUID} to elevate their own privileges.
    // Billing/Counter staff cannot modify admin privileges or promote users.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // 2. Tokens: Customers can get a single token by ID to verify receipt.
    // Bulk listing, token batch generation, blocking, unblocking, deletion, and updates require isAdmin().
    // Server-side updates via Vercel API use Firebase Admin SDK (which bypasses rules).
    match /tokens/{tokenId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // 3. Prizes: Public can read active prizes during mystery box selection.
    // Creating, editing, or deleting prize inventory requires isAdmin().
    match /prizes/{prizeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Winners: Customers can get a single winner document by ID for claim pass.
    // Writes are restricted to authorized admins (Admin SDK / Cloud Functions automatically bypass rules).
    match /winners/{winnerId} {
      allow get: if true;
      allow create, list, update, delete: if isAdmin();
    }

    // 5. Claims: Customers can get a single claim document by Claim ID.
    // Writes are restricted to authorized admins (Admin SDK / Cloud Functions automatically bypass rules).
    match /claims/{claimId} {
      allow get: if true;
      allow create, list, update, delete: if isAdmin();
    }

    // 6. Campaigns & Time Slots: Public read (for campaign status & slot unlock checks), admin write.
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();

      match /timeSlots/{slotId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // 7. Security Audit Logs: STRICTLY RESTRICTED to active admins only.
    // Prevents public customers from creating fake/spoofed activity log entries.
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 8. Settings: Public read (for campaignState), admin write.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Test Tokens (Demo Mode): Isolated collection for client demonstrations
    // Customers can verify a single test token; listing and administrative actions require isAdmin().
    match /testTokens/{tokenId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // 10. Admin Device & Session Management:
    // - Unauthenticated users & non-admins have zero read/write access.
    // - Active admins can read their own session matching ${uid}_${deviceId}.
    // - Authorized session managers (OWNER/ADMIN) can list and inspect sessions.
    // - Session creation requires caller's UID and role match with /admins record.
    // - Setting isMasterDevice=true is strictly reserved for the Master Owner UID.
    // - Master Owner session is permanently protected against revocation and deletion.
    // - Ownership UID, deviceId, and role can never be altered on update.
    match /adminSessions/{sessionId} {
      allow get: if isAdmin() && (
        (resource != null && resource.data.uid == request.auth.uid && sessionId == request.auth.uid + '_' + resource.data.deviceId) ||
        (resource == null && sessionId.matches('^' + request.auth.uid + '_.*')) ||
        isSessionManager()
      );

      allow list: if isSessionManager();

      allow create: if isAdmin() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.deviceId is string &&
        request.resource.data.deviceId.size() > 0 &&
        sessionId == request.auth.uid + '_' + request.resource.data.deviceId &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.role == get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role &&
        (request.resource.data.isMasterDevice == false || isMasterOwner());

      allow update: if isAdmin() && (
        // Self-update by active session owner (e.g. heartbeat, environment details)
        (
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.deviceId == resource.data.deviceId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isMasterDevice == resource.data.isMasterDevice &&
          resource.data.status == 'ACTIVE' &&
          request.resource.data.status == 'ACTIVE'
        ) ||
        // Remote revocation by authorized session manager (cannot touch Master Owner)
        (
          isSessionManager() &&
          resource.data.uid != 'PXvOs3LHpoaowbgmfqrg2BT15uA2' &&
          resource.data.isMasterDevice != true &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.deviceId == resource.data.deviceId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isMasterDevice == resource.data.isMasterDevice &&
          request.resource.data.status == 'REVOKED'
        ) ||
        // Master Owner updating their own session
        (
          isMasterOwner() &&
          resource.data.uid == 'PXvOs3LHpoaowbgmfqrg2BT15uA2' &&
          request.resource.data.uid == 'PXvOs3LHpoaowbgmfqrg2BT15uA2' &&
          request.resource.data.deviceId == resource.data.deviceId &&
          request.resource.data.isMasterDevice == true
        )
      );

      allow delete: if isOwner() &&
        resource.data.uid != 'PXvOs3LHpoaowbgmfqrg2BT15uA2' &&
        resource.data.isMasterDevice != true;
    }
  }
}
